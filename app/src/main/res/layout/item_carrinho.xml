<?xml version="1.0" encoding="utf-8"?>
<!-- item_carrinho.xml · Pura Essência · Minimalista Natural Premium -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Textos -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCarrinhoNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Produto"
                android:textColor="@color/verde_escuro"
                android:textSize="14sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvCarrinhoQtd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Qtd: 1"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Preço -->
        <TextView
            android:id="@+id/tvCarrinhoSubtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="R$ 0,00"
            android:textColor="@color/verde_medio"
            android:textSize="15sp"
            android:fontFamily="serif"
            android:textStyle="bold" />

        <!-- Botão remover -->
        <Button
            android:id="@+id/btnRemoverCarrinho"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:backgroundTint="@color/borda_card"
            android:text="✕"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            android:padding="0dp"
            app:cornerRadius="17dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>