<?xml version="1.0" encoding="utf-8"?>
<!-- item_pedido.xml · Pura Essência · TalkBack corrigido -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Linha superior: ID + Data -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPedidoId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pedido #ABC123"
                android:textColor="@color/verde_escuro"
                android:textSize="14sp"
                android:fontFamily="serif"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPedidoData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01/01/2025"
                android:textColor="@color/texto_secundario"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Linha: Total + Pagamento -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPedidoTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="R$ 0,00"
                android:textColor="@color/verde_medio"
                android:textSize="16sp"
                android:fontFamily="serif"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPedidoPagamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/verde_fundo_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Pix"
                android:textColor="@color/texto_badge"
                android:textSize="11sp"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/borda_card"
            android:importantForAccessibility="no" />

        <!-- Rastreio -->
        <LinearLayout
            android:id="@+id/layoutRastreio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="RASTREIO DO PEDIDO"
                android:textColor="@color/texto_badge"
                android:textSize="10sp"
                android:letterSpacing="0.15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Preparação -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/icPreparacao"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@color/borda_card"
                        android:gravity="center"
                        android:text="📦"
                        android:textSize="18sp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp"
                        android:text="Preparação"
                        android:textColor="@color/texto_secundario"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Linha conectora 1 -->
                <View
                    android:id="@+id/linhaEtapa1"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="0.5"
                    android:background="@color/borda_suave"
                    android:importantForAccessibility="no" />

                <!-- Transporte -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/icTransportadora"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@color/borda_card"
                        android:gravity="center"
                        android:text="🚚"
                        android:textSize="18sp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp"
                        android:text="Transporte"
                        android:textColor="@color/texto_secundario"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Linha conectora 2 -->
                <View
                    android:id="@+id/linhaEtapa2"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="0.5"
                    android:background="@color/borda_suave"
                    android:importantForAccessibility="no" />

                <!-- Entregue -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/icEntregue"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@color/borda_card"
                        android:gravity="center"
                        android:text="✅"
                        android:textSize="18sp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp"
                        android:text="Entregue"
                        android:textColor="@color/texto_secundario"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:maxLines="1" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Status aberto: pendente / cancelado -->
        <LinearLayout
            android:id="@+id/layoutStatusAberto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:background="@color/verde_fundo_badge"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvStatusIcone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="⏳"
                android:textSize="16sp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvStatusAberto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pagamento em processamento"
                android:textColor="@color/verde_escuro"
                android:textSize="12sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:accessibilityLiveRegion="polite" />

        </LinearLayout>

        <!-- Botão Cancelar — aparece apenas para pedidos pendentes -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelarPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:text="CANCELAR PEDIDO  ✕"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:background="@drawable/btn_cancelar"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:contentDescription="Cancelar este pedido" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
