<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/creme_fundo">

    <!-- HEADER -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/verde_escuro" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp">
        <ImageButton android:id="@+id/btnVoltar" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_seta_voltar" android:contentDescription="Voltar" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Boleto Bancário" android:textColor="@color/white" android:textSize="17sp" android:fontFamily="serif" android:textStyle="italic" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <!-- Aviso -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚠️ Boleto simulado — em produção seria emitido por um banco real" android:textColor="#856404" android:textSize="12sp" android:background="@color/white" android:padding="12dp" android:layout_marginBottom="16dp" />

            <!-- Valor -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Valor do boleto" android:textColor="@color/texto_secundario" android:textSize="13sp" />
                    <TextView android:id="@+id/tvValorBoleto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 0,00" android:textColor="@color/verde_escuro" android:textSize="20sp" android:textStyle="bold" android:fontFamily="serif" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Código de barras visual -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CÓDIGO DE BARRAS" android:textColor="@color/texto_badge" android:textSize="10sp" android:letterSpacing="0.15" android:layout_marginBottom="12dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="60dp" android:text="|||  || ||| | || ||| | || ||| |||| | || ||| || | ||| | || |||" android:textColor="#000000" android:textSize="14sp" android:fontFamily="monospace" android:gravity="center" android:letterSpacing="0.1" android:contentDescription="Código de barras do boleto" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Linha digitável -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Linha digitável" android:textColor="@color/texto_secundario" android:textSize="11sp" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvLinhaDigitavel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/texto_principal" android:textSize="12sp" android:fontFamily="monospace" android:layout_marginBottom="10dp" android:accessibilityLiveRegion="polite" />
                    <Button android:id="@+id/btnCopiarBoleto" android:layout_width="wrap_content" android:layout_height="44dp" android:text="📋 Copiar código" android:textSize="12sp" android:backgroundTint="@color/verde_fundo_badge" android:textColor="@color/verde_escuro" app:cornerRadius="8dp" android:contentDescription="Copiar linha digitável do boleto para área de transferência" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Informações -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Beneficiário" android:textColor="@color/texto_secundario" android:textSize="11sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pura Essência LTDA" android:textColor="@color/texto_principal" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vencimento" android:textColor="@color/texto_secundario" android:textSize="11sp" />
                            <TextView android:id="@+id/tvVencimento" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#e67e22" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nosso Número" android:textColor="@color/texto_secundario" android:textSize="11sp" />
                            <TextView android:id="@+id/tvNossoNumero" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/texto_principal" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Instrução" android:textColor="@color/texto_secundario" android:textSize="11sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Não receber após vencimento" android:textColor="@color/texto_principal" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Instruções -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Como pagar:" android:textColor="@color/texto_principal" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. Copie o código ou anote a linha digitável" android:textColor="@color/texto_secundario" android:textSize="12sp" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. Pague pelo app do banco, lotérica ou agência" android:textColor="@color/texto_secundario" android:textSize="12sp" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3. O pagamento é processado em até 2 dias úteis" android:textColor="@color/texto_secundario" android:textSize="12sp" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4. Clique em Confirmar para registrar seu pedido" android:textColor="@color/texto_secundario" android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/btnConfirmarBoleto" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="12dp" android:layout_marginBottom="16dp" android:backgroundTint="@color/verde_escuro" android:text="✅ CONFIRMAR PEDIDO" android:textColor="@color/white" android:textSize="13sp" android:letterSpacing="0.08" android:textStyle="bold" android:singleLine="true" app:cornerRadius="12dp" />
</LinearLayout>
