<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#023804">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Logo -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            app:srcCompat="@drawable/icone_essencia" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recuperar Senha"
            android:textColor="#FFFDD0"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enviaremos um código para seu email"
            android:textColor="#A8D5A2"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <!-- Card com os campos -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFDD0">

                <!-- ETAPA 1: Email -->
                <LinearLayout
                    android:id="@+id/layoutEtapa1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Digite seu email cadastrado"
                        android:textColor="#023804"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Email"
                        android:inputType="textEmailAddress"
                        android:padding="12dp"
                        android:background="@drawable/fundo_input_branco"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnEnviarCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#023804"
                        android:text="Enviar Código"
                        android:textColor="#FFFDD0"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <!-- ETAPA 2: Código e nova senha -->
                <LinearLayout
                    android:id="@+id/layoutEtapa2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvEmailEnviado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Código enviado para: email@email.com"
                        android:textColor="#5D8A3E"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp" />

                    <EditText
                        android:id="@+id/etCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Código de 6 dígitos"
                        android:inputType="number"
                        android:maxLength="6"
                        android:padding="12dp"
                        android:background="@drawable/fundo_input_branco"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:letterSpacing="0.3" />

                    <EditText
                        android:id="@+id/etNovaSenha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Nova senha (mín. 6 caracteres)"
                        android:inputType="textPassword"
                        android:padding="12dp"
                        android:background="@drawable/fundo_input_branco"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etConfirmarSenha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Confirmar nova senha"
                        android:inputType="textPassword"
                        android:padding="12dp"
                        android:background="@drawable/fundo_input_branco"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnRedefinir"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#023804"
                        android:text="Redefinir Senha"
                        android:textColor="#FFFDD0"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />

                    <Button
                        android:id="@+id/btnReenviar"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#A8D5A2"
                        android:text="Reenviar código"
                        android:textColor="#023804"
                        android:textSize="13sp"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@android:color/transparent"
            android:text="← Voltar para o login"
            android:textColor="#A8D5A2"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
