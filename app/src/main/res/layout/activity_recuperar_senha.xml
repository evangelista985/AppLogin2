<?xml version="1.0" encoding="utf-8"?>
<!-- activity_recuperar_senha.xml · Pura Essência · Minimalista Natural Premium -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_escuro">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Logo badge arredondado -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLogo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/creme_fundo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="0dp"
                app:srcCompat="@drawable/logo_escuro"
                android:scaleType="fitCenter" />
        </androidx.cardview.widget.CardView>

        <!-- Marca -->
        <TextView
            android:id="@+id/tvMarca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="PURA ESSÊNCIA"
            android:textColor="@color/verde_menta"
            android:textSize="11sp"
            android:letterSpacing="0.25"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardLogo" />

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Recuperar Senha"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:fontFamily="serif"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMarca" />

        <TextView
            android:id="@+id/tvDescricao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Enviaremos um código para seu e-mail"
            android:textColor="@color/verde_claro"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSubtitulo" />

        <!-- Card Principal -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPrincipal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/creme_fundo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDescricao">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- ── ETAPA 1: Email ── -->
                <LinearLayout
                    android:id="@+id/layoutEtapa1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="E-MAIL CADASTRADO"
                        android:textColor="@color/texto_badge"
                        android:textSize="10sp"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="seu@email.com"
                        android:inputType="textEmailAddress"
                        android:padding="14dp"
                        android:background="@drawable/fundo_input_branco"
                        android:textColor="@color/texto_principal"
                        android:textColorHint="@color/texto_secundario"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnEnviarCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/verde_escuro"
                        android:text="ENVIAR CÓDIGO"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:letterSpacing="0.1"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- ── ETAPA 2: Código + Nova Senha ── -->
                <LinearLayout
                    android:id="@+id/layoutEtapa2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvEmailEnviado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Código enviado para: email@email.com"
                        android:textColor="@color/verde_medio"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CÓDIGO DE 6 DÍGITOS"
                        android:textColor="@color/texto_badge"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="000000"
                        android:inputType="number"
                        android:maxLength="6"
                        android:padding="14dp"
                        android:background="@drawable/fundo_input_branco"
                        android:textColor="@color/texto_principal"
                        android:textColorHint="@color/texto_secundario"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:letterSpacing="0.3"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NOVA SENHA"
                        android:textColor="@color/texto_badge"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp"
                        android:layout_marginTop="14dp" />

                    <EditText
                        android:id="@+id/etNovaSenha"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Mínimo 6 caracteres"
                        android:inputType="textPassword"
                        android:padding="14dp"
                        android:background="@drawable/fundo_input_branco"
                        android:textColor="@color/texto_principal"
                        android:textColorHint="@color/texto_secundario"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONFIRMAR NOVA SENHA"
                        android:textColor="@color/texto_badge"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp"
                        android:layout_marginTop="14dp" />

                    <EditText
                        android:id="@+id/etConfirmarSenha"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Repita a nova senha"
                        android:inputType="textPassword"
                        android:padding="14dp"
                        android:background="@drawable/fundo_input_branco"
                        android:textColor="@color/texto_principal"
                        android:textColorHint="@color/texto_secundario"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnRedefinir"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/verde_escuro"
                        android:text="REDEFINIR SENHA"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:letterSpacing="0.1"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                    <Button
                        android:id="@+id/btnReenviar"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/verde_fundo_badge"
                        android:text="Reenviar código"
                        android:textColor="@color/verde_escuro"
                        android:textSize="13sp"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:indeterminateTint="@color/verde_escuro"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Rodapé -->
        <TextView
            android:id="@+id/tvRodape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="Pura Essência · Natureza e bem-estar"
            android:textColor="@color/verde_claro"
            android:textSize="11sp"
            android:fontFamily="serif"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardPrincipal" />

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@android:color/transparent"
            android:text="← Voltar para o login"
            android:textColor="@color/verde_claro"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvRodape" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
