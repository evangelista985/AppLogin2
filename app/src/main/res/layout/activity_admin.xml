<?xml version="1.0" encoding="utf-8"?>
<!-- activity_admin.xml · Pura Essência · Minimalista Natural Premium -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/creme_fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══ HEADER ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/verde_escuro"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <androidx.cardview.widget.CardView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/creme_fundo">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="0dp"
                    app:srcCompat="@drawable/logo"
                    android:scaleType="fitCenter" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PURA ESSÊNCIA"
                    android:textColor="@color/verde_claro"
                    android:textSize="9sp"
                    android:letterSpacing="0.2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configurações"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:fontFamily="serif"
                    android:textStyle="italic" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ── Card: Informações da Conta ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="INFORMAÇÕES DA CONTA"
                        android:textColor="@color/texto_badge"
                        android:textSize="10sp"
                        android:letterSpacing="0.15" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <androidx.cardview.widget.CardView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/verde_fundo_badge">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="🌿"
                                android:gravity="center"
                                android:textSize="18sp" />
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvAdminEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Usuário: —"
                                android:textColor="@color/texto_principal"
                                android:textSize="14sp"
                                android:fontFamily="serif" />

                            <TextView
                                android:id="@+id/tvAmbiente"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Ambiente: —"
                                android:textColor="@color/texto_badge"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Card: Sobre o App ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="SOBRE O APP"
                        android:textColor="@color/texto_badge"
                        android:textSize="10sp"
                        android:letterSpacing="0.15" />

                    <TextView
                        android:id="@+id/tvVersao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Versão: —"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Card: Configurações ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="CONFIGURAÇÕES"
                        android:textColor="@color/texto_badge"
                        android:textSize="10sp"
                        android:letterSpacing="0.15" />

                    <!-- Notificações -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🔔  Notificações"
                            android:textColor="@color/texto_principal"
                            android:textSize="14sp" />

                        <Switch
                            android:id="@+id/switchNotificacoes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/verde_escuro"
                            android:trackTint="@color/verde_menta" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/borda_card"
                        android:layout_marginBottom="4dp" />

                    <!-- Modo Escuro -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🌙  Modo Escuro"
                            android:textColor="@color/texto_principal"
                            android:textSize="14sp" />

                        <Switch
                            android:id="@+id/switchModoEscuro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/verde_escuro"
                            android:trackTint="@color/verde_menta" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Botão Voltar ── -->
            <Button
                android:id="@+id/btnVoltarAdmin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/verde_fundo_badge"
                android:text="VOLTAR"
                android:textColor="@color/verde_escuro"
                android:textSize="13sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <!-- ── Botão Sair ── -->
            <Button
                android:id="@+id/btnSair"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/white"
                android:text="SAIR DA CONTA"
                android:textColor="@color/vermelho_sair"
                android:textSize="13sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>