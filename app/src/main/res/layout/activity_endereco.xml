<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/creme_fundo">

    <!-- ═══ HEADER ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_escuro"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_seta_voltar"
            android:contentDescription="Voltar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Endereço de entrega"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:fontFamily="serif"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- ═══ SCROLL OCUPA O ESPAÇO RESTANTE ═══ -->
    <ScrollView
        android:id="@+id/scrollViewEndereco"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- Card principal -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Onde vamos entregar?"
                        android:textColor="@color/texto_principal"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="14dp"
                        android:text="Escolha uma das opções abaixo:"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp" />

                    <!-- Opção 1: Endereço do cadastro -->
                    <LinearLayout
                        android:id="@+id/optCadastro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_opcao_inativa"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <View
                            android:id="@+id/radioCadastro"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/radio_inativo" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Entregar no meu endereço"
                                android:textColor="@color/texto_principal"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvEnderecoSalvo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="📍 Carregando..."
                                android:textColor="@color/verde_medio"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/badge_green"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:text="Meu endereço padrão"
                                android:textColor="@color/verde_escuro"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Opção 2: Outro endereço (temporário) -->
                    <LinearLayout
                        android:id="@+id/optTemporario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_opcao_inativa"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <View
                            android:id="@+id/radioTemporario"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/radio_inativo" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Entregar em outro endereço"
                                android:textColor="@color/texto_principal"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Apenas para este pedido — seu cadastro não será alterado"
                                android:textColor="@color/texto_secundario"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/badge_blue"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:text="Endereço temporário"
                                android:textColor="@color/texto_principal"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Opção 3: Atualizar endereço padrão -->
                    <LinearLayout
                        android:id="@+id/optAtualizar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_opcao_inativa"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <View
                            android:id="@+id/radioAtualizar"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/radio_inativo" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Atualizar meu endereço padrão"
                                android:textColor="@color/texto_principal"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Informe um novo endereço e salve no seu cadastro"
                                android:textColor="@color/texto_secundario"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/borda_card" />

                    <!-- Formulário (opção 2 e 3) -->
                    <LinearLayout
                        android:id="@+id/layoutFormEndereco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvSecaoTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Informe o endereço de entrega"
                            android:textColor="@color/texto_secundario"
                            android:textSize="11sp"
                            android:letterSpacing="0.04" />

                        <LinearLayout
                            android:id="@+id/infoBoxTemporario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_info_box"
                            android:orientation="horizontal"
                            android:padding="10dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:text="ℹ"
                                android:textColor="#B59A00"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Este endereço será usado só neste pedido e não afeta o seu cadastro."
                                android:textColor="#6B5C00"
                                android:textSize="12sp"
                                android:lineSpacingExtra="2dp" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etCep"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/fundo_input_branco"
                            android:hint="CEP (somente números)"
                            android:inputType="number"
                            android:maxLength="8"
                            android:padding="11dp"
                            android:textSize="13sp"
                            android:textColor="@color/texto_principal"
                            android:textColorHint="@color/verde_medio" />

                        <EditText
                            android:id="@+id/etRua"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/fundo_input_branco"
                            android:hint="Rua / Logradouro"
                            android:inputType="text"
                            android:padding="11dp"
                            android:textSize="13sp"
                            android:textColor="@color/texto_principal"
                            android:textColorHint="@color/verde_medio" />

                        <EditText
                            android:id="@+id/etNumero"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/fundo_input_branco"
                            android:hint="Número"
                            android:inputType="text"
                            android:padding="11dp"
                            android:textSize="13sp"
                            android:textColor="@color/texto_principal"
                            android:textColorHint="@color/verde_medio" />

                        <EditText
                            android:id="@+id/etBairro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/fundo_input_branco"
                            android:hint="Bairro"
                            android:inputType="text"
                            android:padding="11dp"
                            android:textSize="13sp"
                            android:textColor="@color/texto_principal"
                            android:textColorHint="@color/verde_medio" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etCidade"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:background="@drawable/fundo_input_branco"
                                android:hint="Cidade"
                                android:inputType="text"
                                android:padding="11dp"
                                android:textSize="13sp"
                                android:textColor="@color/texto_principal"
                                android:textColorHint="@color/verde_medio" />

                            <EditText
                                android:id="@+id/etEstado"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/fundo_input_branco"
                                android:hint="Estado"
                                android:inputType="text"
                                android:maxLength="2"
                                android:padding="11dp"
                                android:textSize="13sp"
                                android:textColor="@color/texto_principal"
                                android:textColorHint="@color/verde_medio" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etComplemento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/fundo_input_branco"
                            android:hint="Complemento (opcional)"
                            android:inputType="text"
                            android:padding="11dp"
                            android:textSize="13sp"
                            android:textColor="@color/texto_principal"
                            android:textColorHint="@color/verde_medio" />

                        <Button
                            android:id="@+id/btnCalcularFrete"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="@color/verde_escuro"
                            android:text="Calcular frete"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            app:cornerRadius="10dp" />

                        <TextView
                            android:id="@+id/tvFrete"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/texto_principal"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Frete opção 1 -->
                    <LinearLayout
                        android:id="@+id/layoutFreteCadastro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/btnCalcularFreteCadastro"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:backgroundTint="@color/verde_escuro"
                            android:text="Calcular frete"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            app:cornerRadius="10dp" />

                        <TextView
                            android:id="@+id/tvFreteCadastro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/texto_principal"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- ═══ BOTÃO FIXO NO RODAPÉ ═══ -->
    <Button
        android:id="@+id/btnProsseguirPagamento"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/verde_escuro"
        android:text="PROSSEGUIR PAGAMENTO"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:letterSpacing="0.08"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:singleLine="true"
        app:cornerRadius="12dp" />

</LinearLayout>