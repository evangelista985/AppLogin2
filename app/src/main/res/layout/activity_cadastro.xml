<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#023804">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            app:srcCompat="@drawable/icone_essencia" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:text="Criar Conta 🌿"
            android:textColor="#FFFDD0"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFDD0">

                <!-- Dados pessoais -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="📋 Dados Pessoais"
                    android:textColor="#023804"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/fundo_input_branco"
                    android:hint="Nome completo *"
                    android:inputType="textPersonName"
                    android:padding="12dp"
                    android:textColorHint="#023804" />

                <EditText android:id="@+id/editTextEmail"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:background="@drawable/fundo_input_branco"
                    android:hint="E-mail *" android:inputType="textEmailAddress"
                    android:padding="12dp" android:textColorHint="#023804" />

                <EditText android:id="@+id/editTextTelefone"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:background="@drawable/fundo_input_branco"
                    android:hint="Telefone" android:inputType="phone"
                    android:padding="12dp" android:textColorHint="#023804" />

                <EditText android:id="@+id/editTextCpf"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:background="@drawable/fundo_input_branco"
                    android:hint="CPF" android:inputType="number"
                    android:padding="12dp" android:textColorHint="#023804" />

                <EditText android:id="@+id/editTextSenha"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp" android:background="@drawable/fundo_input_branco"
                    android:hint="Senha * (mín. 6 caracteres)" android:inputType="textPassword"
                    android:padding="12dp" android:textColorHint="#023804" />

                <!-- Endereço -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="📍 Endereço de Entrega"
                    android:textColor="#023804"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText android:id="@+id/editTextCep"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:background="@drawable/fundo_input_branco"
                    android:hint="CEP" android:inputType="number" android:maxLength="8"
                    android:padding="12dp" android:textColorHint="#023804" />

                <EditText android:id="@+id/editTextEndereco"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:background="@drawable/fundo_input_branco"
                    android:hint="Rua / Logradouro" android:inputType="text"
                    android:padding="12dp" android:textColorHint="#023804" />

                <EditText android:id="@+id/editTextNumero"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:background="@drawable/fundo_input_branco"
                    android:hint="Número" android:inputType="text"
                    android:padding="12dp" android:textColorHint="#023804" />

                <EditText android:id="@+id/editTextBairro"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:background="@drawable/fundo_input_branco"
                    android:hint="Bairro" android:inputType="text"
                    android:padding="12dp" android:textColorHint="#023804" />

                <EditText android:id="@+id/editTextCidade"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:background="@drawable/fundo_input_branco"
                    android:hint="Cidade" android:inputType="text"
                    android:padding="12dp" android:textColorHint="#023804" />

                <EditText android:id="@+id/editTextEstado"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" android:background="@drawable/fundo_input_branco"
                    android:hint="Estado (ex: SP)" android:inputType="text" android:maxLength="2"
                    android:padding="12dp" android:textColorHint="#023804" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnCadastro"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#023804"
                    android:text="🌿 Criar Conta"
                    android:textColor="#FFFDD0"
                    android:textSize="16sp"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
