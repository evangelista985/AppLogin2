<?xml version="1.0" encoding="utf-8"?>
<!-- activity_pagamento.xml · Pura Essência · Minimalista Natural Premium -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/creme_fundo">

    <!-- ═══ HEADER ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_escuro"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">



        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_seta_voltar"
            android:contentDescription="Voltar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Pagamento"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:fontFamily="serif"
            android:textStyle="italic" />

    </LinearLayout>

    <!-- ═══ SCROLL OCUPA O ESPAÇO RESTANTE ═══ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- ═══ RESUMO DO PEDIDO ═══ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESUMO DO PEDIDO"
                        android:textColor="@color/texto_badge"
                        android:textSize="10sp"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="12dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/borda_card" android:layout_marginBottom="12dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Subtotal"
                            android:textColor="@color/texto_secundario" android:textSize="14sp" />
                        <TextView android:id="@+id/tvSubtotal" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="R$ 0,00"
                            android:textColor="@color/texto_principal" android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Frete"
                            android:textColor="@color/texto_secundario" android:textSize="14sp" />
                        <TextView android:id="@+id/tvFrete" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="R$ 0,00"
                            android:textColor="@color/texto_principal" android:textSize="14sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/borda_card" android:layout_marginBottom="12dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="TOTAL"
                            android:textColor="@color/texto_badge" android:textSize="11sp" android:letterSpacing="0.1" />
                        <TextView android:id="@+id/tvTotal" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="R$ 0,00"
                            android:textColor="@color/verde_escuro" android:textSize="20sp"
                            android:fontFamily="serif" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ═══ FORMA DE PAGAMENTO ═══ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FORMA DE PAGAMENTO"
                        android:textColor="@color/texto_badge"
                        android:textSize="10sp"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="14dp" />

                    <RadioGroup
                        android:id="@+id/rgPagamento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbPix"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Pix"
                            android:textColor="@color/texto_principal"
                            android:textSize="15sp"
                            android:buttonTint="@color/verde_escuro"
                            android:background="@color/verde_fundo_badge"
                            android:padding="14dp" />

                        <RadioButton
                            android:id="@+id/rbCartao"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="Cartão de Crédito"
                            android:textColor="@color/texto_principal"
                            android:textSize="15sp"
                            android:buttonTint="@color/verde_escuro"
                            android:background="@color/borda_card"
                            android:padding="14dp" />

                        <RadioButton
                            android:id="@+id/rbBoleto"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="Boleto Bancário"
                            android:textColor="@color/texto_principal"
                            android:textSize="15sp"
                            android:buttonTint="@color/verde_escuro"
                            android:background="@color/borda_card"
                            android:padding="14dp" />
                    </RadioGroup>

                    <!-- ═══ CARD VISUAL DO CARTÃO ═══ -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardFormCartao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/verde_fundo_badge">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <FrameLayout
                                android:id="@+id/frameCartao"
                                android:layout_width="match_parent"
                                android:layout_height="180dp"
                                android:layout_marginBottom="16dp">

                                <LinearLayout
                                    android:id="@+id/cardFrente"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="20dp"
                                    android:background="@drawable/bg_cartao_verde"
                                    android:visibility="visible">

                                    <LinearLayout
                                        android:id="@+id/layoutBadgeBandeira"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:visibility="gone"
                                        android:layout_marginBottom="8dp">
                                        <TextView
                                            android:id="@+id/tvBandeiraDetectada"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="11sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/tvNumeroCartao"
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="1"
                                        android:gravity="center_vertical"
                                        android:text="**** **** **** ****"
                                        android:textColor="@color/white"
                                        android:textSize="13sp"
                                        android:fontFamily="monospace"
                                        android:letterSpacing="0.05"
                                        android:singleLine="true" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center_vertical">

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="TITULAR"
                                                android:textColor="#aaffffff"
                                                android:textSize="9sp" />
                                            <TextView
                                                android:id="@+id/tvNomeTitular"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="NOME DO TITULAR"
                                                android:textColor="@color/white"
                                                android:textSize="13sp"
                                                android:textStyle="bold" />
                                        </LinearLayout>

                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:orientation="vertical"
                                            android:gravity="end">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="VALIDADE"
                                                android:textColor="#aaffffff"
                                                android:textSize="9sp" />
                                            <TextView
                                                android:id="@+id/tvValidadeCartao"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="MM/AA"
                                                android:textColor="@color/white"
                                                android:textSize="13sp"
                                                android:textStyle="bold" />
                                        </LinearLayout>

                                        <TextView
                                            android:id="@+id/tvBandeira"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="12dp"
                                            android:text=""
                                            android:textColor="@color/white"
                                            android:textSize="16sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/cardVerso"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:background="@drawable/bg_cartao_verde"
                                    android:visibility="gone"
                                    android:gravity="center_vertical">

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="40dp"
                                        android:background="#222"
                                        android:layout_marginBottom="16dp" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:paddingStart="20dp"
                                        android:paddingEnd="20dp"
                                        android:gravity="center_vertical">

                                        <View
                                            android:layout_width="0dp"
                                            android:layout_height="36dp"
                                            android:layout_weight="1"
                                            android:background="#eee" />

                                        <TextView
                                            android:id="@+id/tvCvvCartao"
                                            android:layout_width="60dp"
                                            android:layout_height="36dp"
                                            android:background="#fff"
                                            android:gravity="center"
                                            android:text="•••"
                                            android:textColor="#333"
                                            android:textSize="16sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>
                            </FrameLayout>

                            <EditText
                                android:id="@+id/etNumeroCartao"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Número do cartão"
                                android:inputType="number"
                                android:maxLength="19"
                                android:layout_marginBottom="10dp" />

                            <EditText
                                android:id="@+id/etNomeTitular"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Nome do titular"
                                android:inputType="textPersonName"
                                android:layout_marginBottom="10dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="10dp">

                                <EditText
                                    android:id="@+id/etValidade"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="MM/AA"
                                    android:inputType="number"
                                    android:maxLength="5"
                                    android:layout_marginEnd="8dp" />

                                <EditText
                                    android:id="@+id/etCvv"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="CVV"
                                    android:inputType="number"
                                    android:maxLength="4" />
                            </LinearLayout>

                            <Spinner
                                android:id="@+id/spinnerParcelas"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ProgressBar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/verde_escuro"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- ═══ BOTÃO FIXO NO RODAPÉ ═══ -->
    <Button
        android:id="@+id/btnFinalizar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/verde_escuro"
        android:text="FINALIZAR PEDIDO"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:letterSpacing="0.1"
        android:textStyle="bold"
        android:singleLine="true"
        app:cornerRadius="12dp" />

</LinearLayout>