<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#023804"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:srcCompat="@drawable/icone_essencia" />

        <TextView
            android:id="@+id/tvSaudacao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Olá! 🌿"
            android:textColor="#FFFDD0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Botão Carrinho com badge -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnCarrinho"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:backgroundTint="#A8D5A2"
                android:padding="10dp"
                android:src="@drawable/baseline_shopping_cart_24"
                app:tint="#FFFFD5" />

            <TextView
                android:id="@+id/tvCarrinhoQtd"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="#FF5722"
                android:gravity="center"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Botão Rastreio de Pedidos -->
        <ImageButton
            android:id="@+id/btnPedidos"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#5D8A3E"
            android:padding="10dp"
            android:src="@drawable/ic_pedidos"
            app:tint="#FFFDD0"
            app:cornerRadius="22dp" />

        <!-- Botão Admin -->
        <ImageButton
            android:id="@+id/btnAdmin"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#5D8A3E"
            android:padding="10dp"
            android:src="@drawable/ic_account_settings"
            app:tint="#FBFBBD"
            app:cornerRadius="22dp" />

        <!-- Botão Logout -->
        <ImageButton
            android:id="@+id/btnLogout"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#8B0000"
            android:padding="10dp"
            android:src="@drawable/ic_logout"
            app:tint="#FFFDD0"
            app:cornerRadius="22dp" />

    </LinearLayout>

    <!-- Filtros de categoria -->
    <HorizontalScrollView
        android:id="@+id/scrollCategorias"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button android:id="@+id/chipTodos"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="8dp" android:backgroundTint="#023804"
                android:text="Todos" android:textColor="#FFF" android:textSize="12sp"
                app:cornerRadius="18dp" />

            <Button android:id="@+id/chipChas"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="8dp" android:backgroundTint="#5D8A3E"
                android:text="🍵 Chás" android:textColor="#FFFDD0" android:textSize="12sp"
                app:cornerRadius="18dp" />

            <Button android:id="@+id/chipTemperos"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="8dp" android:backgroundTint="#5D8A3E"
                android:text="🌶 Temperos" android:textColor="#FFF" android:textSize="12sp"
                app:cornerRadius="18dp" />

            <Button android:id="@+id/chipErvas"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="8dp" android:backgroundTint="#5D8A3E"
                android:text="🌿 Ervas" android:textColor="#FFF" android:textSize="12sp"
                app:cornerRadius="18dp" />

            <Button android:id="@+id/chipCosmeticos"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:backgroundTint="#5D8A3E"
                android:text="✨ Cosméticos" android:textColor="#FFF" android:textSize="12sp"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollCategorias" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProdutos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        android:background="#FFFDD0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollCategorias" />

</androidx.constraintlayout.widget.ConstraintLayout>
